# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://eams_user:eams_password@localhost:5432/eams_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_here_min_32_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Origin
FRONTEND_URL="http://localhost:5173"

# App Settings
BCRYPT_ROUNDS=12
LOCATION_HEARTBEAT_STALE_MINUTES=45
AUTO_CLOSE_HOUR=23
AUTO_CLOSE_MINUTE=59
LOCATION_RETENTION_DAYS=90
