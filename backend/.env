# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL via Docker) ────────────────────────────────────────
DATABASE_URL="postgresql://eams_user:eams_password@localhost:5432/eams_db?schema=public"

# ── Redis (via Docker) ───────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="eams_access_secret_change_in_production_32chars_min"
JWT_REFRESH_SECRET="eams_refresh_secret_change_in_production_32chars_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Frontend Origin (CORS) ────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── App Config ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
LOCATION_HEARTBEAT_STALE_MINUTES=45
AUTO_CLOSE_HOUR=23
AUTO_CLOSE_MINUTE=59
LOCATION_RETENTION_DAYS=90
